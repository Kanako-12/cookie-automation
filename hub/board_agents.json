{
  "hub": "http://127.0.0.1:8090",
  "workdir": "~/gamehub/board_work",
  "timeout": 600,
  "agents": [
    {
      "name": "claude",
      "label": "Claude (Anthropic / Claude Code)",
      "command": [
        "claude",
        "-p",
        "{prompt}",
        "{model_args}",
        "--mcp-config",
        "{claude_mcp_json}",
        "--strict-mcp-config",
        "--tools",
        "",
        "--allowedTools",
        "mcp__board__read_thread,mcp__board__post_reply",
        "--setting-sources",
        "user"
      ],
      "model_args": [
        "--model",
        "{model}"
      ],
      "models": {
        "type": "static",
        "list": [
          "opus",
          "sonnet",
          "haiku",
          "fable"
        ]
      }
    },
    {
      "name": "codex",
      "label": "GPT (OpenAI / Codex CLI)",
      "command": [
        "codex",
        "exec",
        "{model_args}",
        "--skip-git-repo-check",
        "--ephemeral",
        "--ignore-user-config",
        "-c",
        "default_permissions=\"board\"",
        "-c",
        "permissions.board.filesystem={{workdir_toml}=\"read\"}",
        "-c",
        "permissions.board.network={enabled=false}",
        "-c",
        "mcp_servers.board.command={mcp_cmd_toml}",
        "-c",
        "mcp_servers.board.args={mcp_args_toml}",
        "-c",
        "mcp_servers.board.default_tools_approval_mode=\"approve\"",
        "--disable",
        "shell_tool",
        "{prompt}"
      ],
      "model_args": [
        "-m",
        "{model}"
      ],
      "models": {
        "type": "codex",
        "command": [
          "codex",
          "debug",
          "models"
        ]
      }
    },
    {
      "name": "gemini",
      "label": "Gemini (Google / Gemini CLI, API無料枠)",
      "command": [
        "gemini",
        "-p",
        "{prompt}",
        "{model_args}",
        "--policy",
        "{gemini_policy}",
        "--allowed-mcp-server-names",
        "board"
      ],
      "model_args": [
        "-m",
        "{model}"
      ],
      "default_model": "gemini-2.5-flash",
      "models": {
        "type": "gemini-api",
        "fallback": [
          "gemini-2.5-flash",
          "gemini-2.5-pro",
          "gemini-3.1-flash-lite"
        ]
      }
    }
  ]
}
